{
  "name": "CakePHP 5 Quickstart",
  "dockerComposeFile": [
    "compose.yaml"
  ],
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "/usr/local/php/current/bin:/usr/local/bin:/usr/bin:/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [8765, 3306],
  "portsAttributes": {
    "8765": {
      "label": "CakePHP app",
      "onAutoForward": "notify"
    },
    "3306": {
      "label": "MySQL"
    }
  },
  "containerEnv": {
    "DEBUG": "true",
    "SECURITY_SALT": "change-this-in-real-project",
    "XDEBUG_MODE": "off",
    "DB_HOST": "db",
    "DB_PORT": "3306",
    "DB_USERNAME": "cake",
    "DB_PASSWORD": "cake",
    "DB_DATABASE": "cakephp_app",
    "DB_TEST_DATABASE": "cakephp_test"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug",
        "editorconfig.editorconfig",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker",
        "github.copilot",
        "github.copilot-chat"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "mkdir -p tmp/cache/models tmp/cache/persistent tmp/cache/views tmp/sessions logs && chmod -R 775 tmp logs || true"
}
